APP_TITLE=Personal Shopper Assistant
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/personal_shopper.db
REDIS_URL=redis://localhost:6379/0
CELERY_TIMEZONE=America/New_York
SEARCH_TIMEOUT_SECONDS=12
SEARCH_MAX_RESULTS_PER_PROVIDER=12

# Official provider credentials (set only those you have)
EBAY_APP_ID=
BESTBUY_API_KEY=

# Optional: mark app as read-only when provider credentials are not set
READ_ONLY_MODE=false
